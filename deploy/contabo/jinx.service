# JINX engine on the Contabo execution server (docs/INFRASTRUCTURE.md). Paper mode until the owner arms live trading.
# Installed by deploy/contabo/deploy.sh. Credentials: /etc/jinx/jinx.env (mode 640 root:jinx, see jinx.env.example).
[Unit]
Description=JINX trading engine
After=network-online.target
Wants=network-online.target

[Service]
User=jinx
WorkingDirectory=/opt/jinx/current
EnvironmentFile=/etc/jinx/jinx.env
Environment=JINX_DATA_DIR=/var/lib/jinx HOME=/var/lib/jinx PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/jinx/venv/bin/python -m jinx run --port 8080
Restart=on-failure
RestartSec=5
# Storage hygiene (owner storage rules 1, 2, 5): state only in /var/lib/jinx (the ledger), logs only to the journal
# (capped by journald-jinx.conf), a private /tmp that is emptied when the service stops, and a hard memory ceiling
# above JINX's own 1 GB RAM budget.
StateDirectory=jinx
StateDirectoryMode=0700
PrivateTmp=yes
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000
MemoryHigh=1536M
MemoryMax=2G
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/jinx

[Install]
WantedBy=multi-user.target
