# /etc/jinx/jinx.env on the execution server: owner root, group jinx, mode 640. Values never enter the repository.
# Neon PostgreSQL: the durable trading ledger (pooled connection string from the Neon console)
JINX_DATABASE_URL=
# Railway PostgreSQL: wallet intelligence, research, performance (public TCP proxy connection string)
JINX_RESEARCH_DATABASE_URL=
# Redis Cloud database-MVHIAO2Q: transient state, every key expires
JINX_REDIS_URL=
# Neon Object Storage: daily ledger backup (JINX keeps the newest JINX_BACKUP_KEEP)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
# Neon AI Gateway: asynchronous context only
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
